{
  "manifest_version": 3,
  "name": "My Bot Browser Bridge",
  "version": "0.2.0",
  "description": "Connect My Bot to Chrome tabs it owns.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/robot-on-16.png",
    "32": "icons/robot-on-32.png",
    "48": "icons/robot-on-48.png",
    "128": "icons/robot-on-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/robot-off-16.png",
      "32": "icons/robot-off-32.png",
      "48": "icons/robot-off-48.png",
      "128": "icons/robot-off-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
