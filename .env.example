# Example .env file for my-bot. Rename to .env and fill in real secrets.

LOG_LEVEL="debug"

OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"
OPENAI_API_KEY="your_openai_api_key_here"

CWD="./workspace"
PROJECT_DIR="../"
SKILLS_DIR="./.skills"
CRONS_DIR="./.cron"
SESSION_DIR="./.session"

CONTAINER_NAME=""
CONTAINER_RUNTIME=""
MAX_OUTPUT_CHARS="100000"
WEB_SEARCH_API=""
FETCH_PROXY=""

WAKE_INTERVAL_SECONDS="1800"
CONTEXT_AUTO_COMPRESSION_ENABLED="true"
CONTEXT_MAX_TOKENS="32000"
CONTEXT_COMPRESSION_THRESHOLD="0.7"

FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_ENCRYPT_KEY=""
FEISHU_VERIFICATION_TOKEN=""

VISION_SUPPORT="false"
MAX_IMAGE_SIZE_BYTES="5242880"
FLEET_TOOL_ENABLED="false"

WEBUI_ENABLED="true"
WEBUI_HOST="127.0.0.1"
WEBUI_PORT="8017"
WEBUI_TOKEN=""
